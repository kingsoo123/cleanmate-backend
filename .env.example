PORT=3001
NODE_ENV=development

# Supabase → Database → Connection string → Session pooler (works on IPv4 networks)
DATABASE_URL=postgresql://postgres.ytkqtjyynytnudiohnrp:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Direct connection (IPv6 only on many networks):
# postgresql://postgres:[YOUR-PASSWORD]@db.ytkqtjyynytnudiohnrp.supabase.co:5432/postgres

# Set to true only in local dev when you want TypeORM to auto-create tables (never in production)
DB_SYNCHRONIZE=false
# With DB_SYNCHRONIZE=false, create push token storage once:
# CREATE TABLE IF NOT EXISTS user_push_tokens (
#   id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
#   user_id uuid NOT NULL,
#   token varchar(512) NOT NULL UNIQUE,
#   platform varchar(16) NOT NULL DEFAULT 'web',
#   created_at timestamptz NOT NULL DEFAULT now(),
#   updated_at timestamptz NOT NULL DEFAULT now()
# );
# CREATE INDEX IF NOT EXISTS idx_user_push_tokens_user_id ON user_push_tokens (user_id);

JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d
# Comma-separated browser origins (dev also allows 127.0.0.1 and 192.168.x.x on port 3000)
CORS_ORIGIN=http://localhost:3000
# Used to build absolute links in FCM web push notifications
FRONTEND_URL=http://localhost:3000

# Firebase Admin — prefer a gitignored JSON file in cleanmate-backend/ (Project settings → Service accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=cleanmate-edeb7-firebase-adminsdk-fbsvc-7061878de7.json
# Or inline JSON on one line (overrides PATH when set):
# FIREBASE_SERVICE_ACCOUNT_JSON=
